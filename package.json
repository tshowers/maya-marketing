{
  "name": "maya",
  "version": "2026.10.5-build.3",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "node scripts/generate-version.js && ng serve",
    "build": "node scripts/generate-version.js --bump && ng build && npm run postbuild",
    "build:production": "node scripts/generate-version.js --bump && ng build --configuration production && npm run postbuild",
    "postbuild": "cp dist/maya/browser/index.csr.html dist/maya/browser/index.html",
    "deploy:hosting": "./deploy.sh",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "serve:ssr:maya": "node dist/maya/server/server.mjs"
  },
  "dependencies": {
    "@angular/animations": "^19.2.4",
    "@angular/common": "^19.2.4",
    "@angular/compiler": "^19.2.4",
    "@angular/core": "^19.2.4",
    "@angular/fire": "^19.0.0",
    "@angular/forms": "^19.2.4",
    "@angular/platform-browser": "^19.2.4",
    "@angular/platform-browser-dynamic": "^19.2.4",
    "@angular/platform-server": "^19.2.4",
    "@angular/router": "^19.2.4",
    "@angular/service-worker": "^19.2.4",
    "@angular/ssr": "^19.2.27",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@taliferro/ui": "file:../../taliferro-ui",
    "bootstrap": "^5.3.3",
    "express": "^4.18.2",
    "firebase": "^11.6.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.5",
    "@angular/cli": "^19.2.5",
    "@angular/compiler-cli": "^19.2.4",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.7",
    "@types/node": "^18.18.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  }
